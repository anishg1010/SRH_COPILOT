  "nodes": [
    {
      "id": "input",
      "type": "input",
      "actor": "Student",
      "action": "Application for study programme or campus change and transcript of records are available"
    },
    {
      "id": "01",
      "type": "process_step",
      "actor": "Student",
      "action": "Submit application for study programme or campus change",
      "deadline": "28.02 for summer semester, 31.08 for winter semester",
      "required_documents": "Application form"
    },
    {
      "id": "02",
      "type": "process_step",
      "actor": "Student Service",
      "action": "After formal check, forward the application to the future programme director",
      "deadline": "Immediately",
      "required_documents": "Application"
    },
    {
      "id": "03",
      "type": "process_step",
      "actor": "Future Programme Director",
      "action": "Check whether the change is possible, whether the desired cohort is offered, and whether module transfer or recognition of achievements is required",
      "deadline": "Maximum 2 working days"
    },
    {
      "id": "D01",
      "type": "decision",
      "actor": "Future Programme Director",
      "question": "Is the change possible?"
    },
    {
      "id": "04a",
      "type": "process_step",
      "actor": "Future Programme Director",
      "action": "Reject the application with a reason and forward it to Student Service",
      "deadline": "Immediately"
    },
    {
      "id": "04b",
      "type": "process_step",
      "actor": "Student Service",
      "action": "Inform the student about the rejection, including the reason, and file the application",
      "recipient": "Student"
    },
    {
      "id": "D02",
      "type": "decision",
      "actor": "Future Programme Director",
      "question": "Is recognition of achievements required?"
    },
    {
      "id": "05",
      "type": "process_step",
      "actor": "Future Programme Director",
      "action": "For module transfer: enter the future cohort or continuation of study and forward the application to Student Service",
      "deadline": "Maximum 5 working days"
    },
    {
      "id": "06",
      "type": "process_step",
      "actor": "Future Programme Director",
      "action": "For recognition of achievements: enter recognized modules in the table",
      "deadline": "Maximum 5 working days"
    },
    {
      "id": "07",
      "type": "process_step",
      "actor": "Future Programme Director",
      "action": "Enter the future cohort or continuation of study after recognition and forward the application to the Examination Office"
    },
    {
      "id": "08",
      "type": "process_step",
      "actor": "Examination Office",
      "action": "After completing the recognition process, forward the application to Student Service"
    },
    {
      "id": "09",
      "type": "process_step",
      "actor": "Student Service",
      "action": "Ask Admission about admission possibility and additional agreement",
      "deadline": "Immediately"
    },
    {
      "id": "10",
      "type": "process_step",
      "actor": "Admission",
      "action": "Clarify admission requirements",
      "deadline": "Maximum 2 working days"
    },
    {
      "id": "D03",
      "type": "decision",
      "actor": "Admission",
      "question": "Are the admission requirements fulfilled?"
    },
    {
      "id": "11a",
      "type": "process_step",
      "actor": "Admission",
      "action": "If admission requirements are not fulfilled, reject the application and inform Student Service",
      "deadline": "After check"
    },
    {
      "id": "11b",
      "type": "process_step",
      "actor": "Student Service",
      "action": "Inform the student about the rejection, including the reason, and file the application",
      "deadline": "Immediately"
    },
    {
      "id": "12",
      "type": "process_step",
      "actor": "Admission",
      "action": "If admission requirements are fulfilled, create the additional agreement with recognition of achievements and new fees, and send it to Student Service",
      "deadline": "Maximum 1 working day",
      "required_documents": "Additional agreement template"
    },
    {
      "id": "13",
      "type": "process_step",
      "actor": "Student Service",
      "action": "Send the additional agreement to the student for signature",
      "deadline": "Immediately",
      "required_documents": "Additional agreement"
    },
    {
      "id": "14",
      "type": "process_step",
      "actor": "Student",
      "action": "Sign the additional agreement and send it back to Student Service",
      "deadline": "Maximum 2 working days"
    },
    {
      "id": "15",
      "type": "process_step",
      "actor": "Student Service",
      "action": "Confirm receipt and inform the student about the change at the next possible date",
      "deadline": "Immediately"
    },
    {
      "id": "16",
      "type": "process_step",
      "actor": "Student Service",
      "action": "File the signed additional agreement",
      "deadline": "Immediately",
      "required_documents": "Signed additional agreement"
    },
    {
      "id": "17",
      "type": "process_step",
      "actor": "Student Service",
      "action": "Book the new study programme and deactivate the old study programme",
      "deadline": "After semester end"
    },
    {
      "id": "18",
      "type": "process_step",
      "actor": "Student Service",
      "action": "Inform Fee Management and LVM about the change, including the newly assigned cohort. For campus change, inform services at the destination campus",
      "deadline": "Immediately after change"
    },
    {
      "id": "19",
      "type": "process_step",
      "actor": "LVM",
      "action": "Change the planning group and inform the Examination Office",
      "deadline": "Before semester start"
    },
    {
      "id": "20",
      "type": "process_step",
      "actor": "Examination Office",
      "action": "Complete the recognition of achievements",
      "deadline": "After planning group change"
    },
    {
      "id": "21",
      "type": "process_step",
      "actor": "Fee Management",
      "action": "Adjust fees so that the correct cost center is used; cancel old fees and set new fees",
      "deadline": "Before semester start"
    },
    {
      "id": "22",
      "type": "process_step",
      "actor": "Fee Management",
      "action": "Inform the student about the new fee collection and any changed fees, and file the application",
      "deadline": "After fee adjustment"
    },
    {
      "id": "end_rejected_sgl",
      "type": "end",
      "actor": "Student Service",
      "action": "Process ends because the future programme director rejected the change"
    },
    {
      "id": "end_rejected_admission",
      "type": "end",
      "actor": "Student Service",
      "action": "Process ends because admission requirements are not fulfilled"
    },
    {
      "id": "output",
      "type": "output",
      "actor": "Student Service",
      "action": "Completed application, signed additional agreement, and updated study programme or campus data"
    }
  ],

